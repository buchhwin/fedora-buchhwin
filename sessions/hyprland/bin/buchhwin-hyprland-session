#!/usr/bin/env bash
set -euo pipefail

config_home="${XDG_CONFIG_HOME:-$HOME/.config}/buchhwin-sessions/hyprland"
export XDG_CONFIG_HOME="$config_home"
config="$XDG_CONFIG_HOME/buchhwin/hyprland/hyprland.lua"
[[ -r "$config" ]] || { echo "Missing Buchhwin Hyprland config: $config" >&2; exit 1; }

export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
exec /usr/bin/Hyprland --config "$config"
