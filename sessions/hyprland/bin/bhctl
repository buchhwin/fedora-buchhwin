#!/usr/bin/env bash
set -euo pipefail

case "${XDG_CONFIG_HOME:-}" in
    */buchhwin-sessions/hyprland) CONFIG_HOME="$XDG_CONFIG_HOME" ;;
    *) CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/buchhwin-sessions/hyprland" ;;
esac
STATE="$CONFIG_HOME/buchhwin/shell.json"
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
    cat <<'EOF'
Usage: bhctl <command>

  doctor                         check the KDE/Hyprland session
  reload                         reload Hyprland
  theme <palette> [accent]       select and render a shell theme
  update                         pull the repository and run the installer
  power apply                    apply the saved lid behaviour to logind
  shell restart|status|logs      manage the Buchhwin Quickshell service
  prune                          remove stale Quickshell runtime directories
EOF
}

render_theme() {
    command -v qs >/dev/null || { echo "quickshell is not installed" >&2; return 1; }
    BUCHHWIN_TOOL=render QT_QPA_PLATFORM=offscreen timeout 60 qs -p "$REPO_DIR/shell"
}

doctor() {
    local failed=0 pkg
    printf 'Fedora KDE base\n'
    # sddm is NOT in this list any more: the Display manager section below
    # answers that question properly, and demanding the package named "sddm" on
    # a machine that logs in through something else reported a fault that is not
    # one.
    for pkg in plasma-desktop hyprland xdg-desktop-portal-kde \
               xdg-desktop-portal-hyprland plasma-nm bluedevil dolphin; do
        if rpm -q "$pkg" >/dev/null 2>&1; then
            printf '  ok       %s\n' "$pkg"
        else
            printf '  MISSING  %s\n' "$pkg"
            failed=1
        fi
    done
    printf 'Display manager\n'
    # ⚠️ WHICH ONE IS NOT THIS SESSION'S BUSINESS. This used to report "ERROR
    # sddm is not enabled" on a machine whose login screen works perfectly and
    # happens to be something else. The session is a .desktop file in
    # /usr/share/wayland-sessions and every display manager reads it, so what
    # doctor has to answer is whether there IS one — not which.
    dm=""
    [[ -L /etc/systemd/system/display-manager.service ]] \
        && dm="$(basename "$(readlink -f /etc/systemd/system/display-manager.service)")"
    if [[ -n "$dm" ]]; then
        printf '  ok       %s\n' "${dm%.service}"
    elif systemctl is-enabled --quiet sddm.service 2>/dev/null; then
        printf '  ok       sddm enabled\n'
    else
        printf '  ERROR    no display manager is enabled\n'
        failed=1
    fi
    # greetd is a fault only when it is a SECOND one. If it is the display
    # manager this machine actually uses, the line above already said so, and
    # calling it a conflict would be this session disagreeing with a login
    # screen that works.
    if [[ "$dm" != "greetd.service" ]] \
       && systemctl is-enabled --quiet greetd.service 2>/dev/null; then
        printf '  ERROR    greetd is enabled alongside %s\n' "${dm:-your display manager}"
        failed=1
    else
        printf '  ok       no competing greetd service\n'
    fi
    printf 'Session isolation\n  config   %s\n' "$CONFIG_HOME"
    [[ -r "$CONFIG_HOME/buchhwin/hyprland/hyprland.lua" ]] \
        || { printf '  MISSING  Hyprland configuration\n'; failed=1; }
    [[ -r /usr/share/wayland-sessions/buchhwin-hyprland.desktop ]] \
        || { printf '  MISSING  the wayland-session entry\n'; failed=1; }

    # ⚠️ A NULL SECTION IS WHY A SWITCH SPRINGS BACK, and this check went
    # missing when bhctl was rewritten. The symptom is specific and impossible
    # to guess at: a top-level block in shell.json set to `null` makes
    # JsonAdapter hand back a null object, every write into it is dropped, and
    # the control in the settings window snaps back to where it was with
    # nothing in any log. It was reported once, in exactly those words, and the
    # check that found it was lost with the 1,500 lines this file shed.
    #
    # ⚠️ `null` AS A VALUE IS NOT ONE. A palette genuinely called "null" is a
    # string and is fine; only a section whose whole value is null is broken.
    # That is why this asks jq for the type instead of grepping for the word.
    printf 'Settings file\n'
    local settings="$CONFIG_HOME/buchhwin/shell.json"
    if [[ ! -r "$settings" ]]; then
        printf '  ok       no shell.json yet — the defaults are the settings\n'
    elif ! command -v jq >/dev/null 2>&1; then
        printf '  SKIP     jq is not installed, cannot check for a null section\n'
    else
        local nulls
        nulls="$(jq -r 'to_entries[] | select(.value == null) | .key' \
                 "$settings" 2>/dev/null | paste -sd' ' -)"
        if [[ -n "$nulls" ]]; then
            printf '  BROKEN   null section: %s\n' "$nulls"
            printf '           Every setting in it silently refuses to save. Take the\n'
            printf '           line out of %s and log in again.\n' "$settings"
            failed=1
        else
            printf '  ok       no null section\n'
        fi
    fi
    return "$failed"
}

prune() {
    local dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/quickshell/by-id"
    [[ -d "$dir" ]] || return 0
    command -v qs >/dev/null || return 0
    local listing live d name
    listing="$(qs list --all --json 2>/dev/null)" || return 0
    live="$(sed -n 's/.*"id": "\([^"]*\)".*/\1/p' <<<"$listing")"
    for d in "$dir"/*/; do
        [[ -d "$d" ]] || continue
        name="$(basename "$d")"
        grep -qxF "$name" <<<"$live" || rm -rf -- "$d"
    done
}

apply_power() {
    local action="suspend"
    if [[ -r "$STATE" ]] && command -v jq >/dev/null; then
        action="$(jq -r '.power.lidAction // "suspend"' "$STATE")"
    fi
    case "$action" in suspend|hibernate|poweroff|lock|ignore) ;; *) return 1 ;; esac
    sudo mkdir -p /etc/systemd/logind.conf.d
    sudo tee /etc/systemd/logind.conf.d/50-buchhwin.conf >/dev/null <<EOF
[Login]
HandleLidSwitch=$action
HandleLidSwitchExternalPower=$action
EOF
    sudo systemctl reload systemd-logind.service
}

case "${1:-}" in
    doctor) doctor ;;
    reload) hyprctl reload ;;
    prune) prune ;;
    theme)
        [[ -n "${2:-}" ]] || { echo "theme name required" >&2; exit 2; }
        command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
        mkdir -p "$(dirname "$STATE")"; [[ -r "$STATE" ]] || printf '{}\n' > "$STATE"
        tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
        jq --arg palette "$2" --arg accent "${3:-}" \
          '.theme.palette=$palette | if $accent != "" then .theme.accent=$accent else . end' \
          "$STATE" > "$tmp"
        install -m 0600 "$tmp" "$STATE"; render_theme; hyprctl reload >/dev/null 2>&1 || true
        ;;
    # ⚠️ RESTORED, NOT WRITTEN. This subcommand existed in full and was lost
    # when bhctl was cut from 1615 lines to 116 during the KDE-native cleanup —
    # the same cut that took `doctor`'s null-section check with it. Nothing
    # noticed, because the only thing that calls it is a button:
    # services/Update.qml's install() opens a terminal on `bhctl update`, so
    # "Update and reinstall" in Settings has been opening a terminal that prints
    # the usage text and exits. tests/update-diverged.sh was red the whole time
    # and was being read as a failing test rather than a missing feature.
    update)
        # ⚠️ REFUSES ON A DIRTY TREE. `git pull` on top of local edits either
        # conflicts or silently merges, and the person running this is asking
        # for "make it current", not "resolve my half-finished change". Saying
        # so costs one line; the other way costs an evening.
        cd "$REPO_DIR" || exit 2
        if ! git rev-parse --git-dir >/dev/null 2>&1; then
            echo "$REPO_DIR is not a git checkout — nothing to pull" >&2
            echo "  (this is normal on a machine the tree was rsynced to)" >&2
            exit 1
        fi
        if [[ -n "$(git status --porcelain)" ]]; then
            echo "there are uncommitted changes here — refusing to pull over them" >&2
            git status --short >&2
            exit 1
        fi
        before="$(git rev-parse --short HEAD)"
        # ⚠️⚠️ THE DIVERGED CLONE IS NAMED HERE, BECAUSE "pull failed" NAMES
        # NOTHING. After this repository's history was rewritten with
        # `git-filter-repo` to get a leaked password out of it, every clone made
        # before that run shares NO COMMON ANCESTOR with origin any more — git
        # sees two unrelated histories and `--ff-only` is exactly the form that
        # refuses them:
        #
        #     hint: Diverging branches can't be fast-forwarded
        #     fatal: Not possible to fast-forward, aborting.
        #
        # That happened on a real machine, and the two lines it printed sent
        # nobody anywhere. The warning had been sitting in a handout the whole
        # time, which is the lesson: a warning in a document does nothing while
        # the person is standing in front of the error. The place to say it is
        # here.
        #
        # ⚠️ FETCH FIRST, or there is nothing to compare against — `git pull`
        # would fetch and fail in the same breath, and the merge-base question
        # could only be asked after the answer stopped mattering. A fetch that
        # fails (no network) is not treated as a fault: the pull below gets to
        # give its own error, which is the right one for being offline.
        upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
        if [[ -n "$upstream" ]] && git fetch --quiet 2>/dev/null; then
            # No merge base at all is the rewritten-history case, and ONLY that
            # one. A clone that is merely behind, or that carries local commits,
            # has a merge base — those are ordinary situations with ordinary
            # answers, and sending them down the recipe below would tell
            # somebody to throw away work they still have.
            if ! git merge-base HEAD "$upstream" >/dev/null 2>&1; then
                echo "this clone and $upstream share no common history" >&2
                echo "  the history was rewritten; a clone from before it cannot fast-forward" >&2
                echo "  nothing here is lost — check first, then take origin's side:" >&2
                echo >&2
                echo "    git log --oneline $upstream..HEAD   # empty? then nothing of yours is here" >&2
                echo "    git reset --hard $upstream" >&2
                echo "    ./install-hyprland.sh" >&2
                exit 1
            fi
        fi
        git pull --ff-only || { echo "pull failed" >&2; exit 1; }
        after="$(git rev-parse --short HEAD)"
        if [[ "$before" == "$after" ]]; then
            echo "already current at $after"
            exit 0
        fi
        echo "$before → $after"
        # ⚠️ The installer, not just a shell restart. A pull can change package
        # lists, units and the generated Hyprland config, and none of those
        # reach the machine by restarting quickshell — that is the same "a
        # change with nobody to apply it" fault this project keeps finding.
        #
        # ⚠️ install-hyprland.sh, NOT install.sh: the monorepo merge renamed the
        # session's installer and put a dispatcher at the repository root
        # instead. That rename has now broken four separate things, all of them
        # silently.
        exec bash "$REPO_DIR/install-hyprland.sh"
        ;;
    power) [[ "${2:-}" == apply ]] || { usage; exit 2; }; apply_power ;;
    shell)
        case "${2:-}" in
            restart) systemctl --user restart buchhwin-shell.service ;;
            status) systemctl --user status buchhwin-shell.service ;;
            logs) journalctl --user -u buchhwin-shell.service -n 100 --no-pager ;;
            *) usage; exit 2 ;;
        esac
        ;;
    -h|--help|help|'') usage ;;
    *) usage >&2; exit 2 ;;
esac
