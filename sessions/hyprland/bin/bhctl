#!/usr/bin/env bash
set -euo pipefail

case "${XDG_CONFIG_HOME:-}" in
    */buchhwin-sessions/hyprland) CONFIG_HOME="$XDG_CONFIG_HOME" ;;
    *) CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/buchhwin-sessions/hyprland" ;;
esac
STATE="$CONFIG_HOME/buchhwin/shell.json"
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
    cat <<'EOF'
Usage: bhctl <command>

  doctor                         check the KDE/Hyprland session
  reload                         reload Hyprland
  theme <palette> [accent]       select and render a shell theme
  power apply                    apply the saved lid behaviour to logind
  shell restart|status|logs      manage the Buchhwin Quickshell service
  prune                          remove stale Quickshell runtime directories
EOF
}

render_theme() {
    command -v qs >/dev/null || { echo "quickshell is not installed" >&2; return 1; }
    BUCHHWIN_TOOL=render QT_QPA_PLATFORM=offscreen timeout 60 qs -p "$REPO_DIR/shell"
}

doctor() {
    local failed=0 pkg
    printf 'Fedora KDE base\n'
    for pkg in plasma-desktop sddm hyprland xdg-desktop-portal-kde \
               xdg-desktop-portal-hyprland plasma-nm bluedevil dolphin; do
        if rpm -q "$pkg" >/dev/null 2>&1; then
            printf '  ok       %s\n' "$pkg"
        else
            printf '  MISSING  %s\n' "$pkg"
            failed=1
        fi
    done
    printf 'Display manager\n'
    if systemctl is-enabled --quiet sddm.service; then
        printf '  ok       sddm enabled\n'
    else
        printf '  ERROR    sddm is not enabled\n'
        failed=1
    fi
    if systemctl is-enabled --quiet greetd.service 2>/dev/null; then
        printf '  ERROR    greetd is enabled and conflicts with SDDM\n'
        failed=1
    else
        printf '  ok       no competing greetd service\n'
    fi
    printf 'Session isolation\n  config   %s\n' "$CONFIG_HOME"
    [[ -r "$CONFIG_HOME/buchhwin/hyprland/hyprland.lua" ]] \
        || { printf '  MISSING  Hyprland configuration\n'; failed=1; }
    [[ -r /usr/share/wayland-sessions/buchhwin-hyprland.desktop ]] \
        || { printf '  MISSING  SDDM session entry\n'; failed=1; }

    # ⚠️ A NULL SECTION IS WHY A SWITCH SPRINGS BACK, and this check went
    # missing when bhctl was rewritten. The symptom is specific and impossible
    # to guess at: a top-level block in shell.json set to `null` makes
    # JsonAdapter hand back a null object, every write into it is dropped, and
    # the control in the settings window snaps back to where it was with
    # nothing in any log. It was reported once, in exactly those words, and the
    # check that found it was lost with the 1,500 lines this file shed.
    #
    # ⚠️ `null` AS A VALUE IS NOT ONE. A palette genuinely called "null" is a
    # string and is fine; only a section whose whole value is null is broken.
    # That is why this asks jq for the type instead of grepping for the word.
    printf 'Settings file\n'
    local settings="$CONFIG_HOME/buchhwin/shell.json"
    if [[ ! -r "$settings" ]]; then
        printf '  ok       no shell.json yet — the defaults are the settings\n'
    elif ! command -v jq >/dev/null 2>&1; then
        printf '  SKIP     jq is not installed, cannot check for a null section\n'
    else
        local nulls
        nulls="$(jq -r 'to_entries[] | select(.value == null) | .key' \
                 "$settings" 2>/dev/null | paste -sd' ' -)"
        if [[ -n "$nulls" ]]; then
            printf '  BROKEN   null section: %s\n' "$nulls"
            printf '           Every setting in it silently refuses to save. Take the\n'
            printf '           line out of %s and log in again.\n' "$settings"
            failed=1
        else
            printf '  ok       no null section\n'
        fi
    fi
    return "$failed"
}

prune() {
    local dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/quickshell/by-id"
    [[ -d "$dir" ]] || return 0
    command -v qs >/dev/null || return 0
    local listing live d name
    listing="$(qs list --all --json 2>/dev/null)" || return 0
    live="$(sed -n 's/.*"id": "\([^"]*\)".*/\1/p' <<<"$listing")"
    for d in "$dir"/*/; do
        [[ -d "$d" ]] || continue
        name="$(basename "$d")"
        grep -qxF "$name" <<<"$live" || rm -rf -- "$d"
    done
}

apply_power() {
    local action="suspend"
    if [[ -r "$STATE" ]] && command -v jq >/dev/null; then
        action="$(jq -r '.power.lidAction // "suspend"' "$STATE")"
    fi
    case "$action" in suspend|hibernate|poweroff|lock|ignore) ;; *) return 1 ;; esac
    sudo mkdir -p /etc/systemd/logind.conf.d
    sudo tee /etc/systemd/logind.conf.d/50-buchhwin.conf >/dev/null <<EOF
[Login]
HandleLidSwitch=$action
HandleLidSwitchExternalPower=$action
EOF
    sudo systemctl reload systemd-logind.service
}

case "${1:-}" in
    doctor) doctor ;;
    reload) hyprctl reload ;;
    prune) prune ;;
    theme)
        [[ -n "${2:-}" ]] || { echo "theme name required" >&2; exit 2; }
        command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
        mkdir -p "$(dirname "$STATE")"; [[ -r "$STATE" ]] || printf '{}\n' > "$STATE"
        tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
        jq --arg palette "$2" --arg accent "${3:-}" \
          '.theme.palette=$palette | if $accent != "" then .theme.accent=$accent else . end' \
          "$STATE" > "$tmp"
        install -m 0600 "$tmp" "$STATE"; render_theme; hyprctl reload >/dev/null 2>&1 || true
        ;;
    power) [[ "${2:-}" == apply ]] || { usage; exit 2; }; apply_power ;;
    shell)
        case "${2:-}" in
            restart) systemctl --user restart buchhwin-shell.service ;;
            status) systemctl --user status buchhwin-shell.service ;;
            logs) journalctl --user -u buchhwin-shell.service -n 100 --no-pager ;;
            *) usage; exit 2 ;;
        esac
        ;;
    -h|--help|help|'') usage ;;
    *) usage >&2; exit 2 ;;
esac
