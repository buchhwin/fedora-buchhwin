#!/usr/bin/env bash
set -euo pipefail
state="${1:-}"
[[ "$state" == off || "$state" == on ]] || { echo 'usage: buchhwin-display-power on|off' >&2; exit 2; }
while IFS= read -r output; do
  [[ -n "$output" ]] && wlr-randr --output "$output" "--$state"
done < <(wlr-randr 2>/dev/null | awk '/^[^ ]/ {print $1}')
