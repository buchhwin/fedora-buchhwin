#!/usr/bin/env python3
import json, os, shutil, subprocess, sys
from pathlib import Path
cfg=Path(os.environ.get("XDG_CONFIG_HOME",Path.home()/".config"))/"buchhwin-dwl"/"appearance.json"
cmd=sys.argv[1] if len(sys.argv)>1 else ""
if cmd=="export":
    out=subprocess.run(["zenity","--file-selection","--save","--confirm-overwrite","--filename=buchhwin-theme.json"],text=True,capture_output=True).stdout.strip()
    if out: shutil.copy2(cfg,out); print(out)
elif cmd=="import":
    src=subprocess.run(["zenity","--file-selection","--file-filter=JSON | *.json"],text=True,capture_output=True).stdout.strip()
    if src:
        data=json.loads(Path(src).read_text()); allowed={"icons","cursor","cursorSize","gaps","border","font","theme","accent","background","bar","text","barPosition","barSize"}
        if not set(data)<=allowed: raise SystemExit("Theme contains unsupported settings")
        cfg.parent.mkdir(parents=True,exist_ok=True); cfg.write_text(json.dumps(data,indent=2)+"\n")
        subprocess.run(["pkill","-TERM","-f","^qs -c buchhwin$"]); print("Theme imported")
else: raise SystemExit("usage: buchhwin-theme export|import")
