#!/usr/bin/env bash
set -euo pipefail
if command -v code >/dev/null 2>&1; then exec code "$@"; fi
if command -v code-insiders >/dev/null 2>&1; then exec code-insiders "$@"; fi
if command -v flatpak >/dev/null 2>&1 && flatpak info com.visualstudio.code >/dev/null 2>&1; then
  exec flatpak run com.visualstudio.code "$@"
fi
notify-send "buchhwin" "Visual Studio Code was not found"
exit 127
