#!/usr/bin/env python3
"""Read or change the image in the dedicated Fastfetch configuration."""
import json
import os
from pathlib import Path
import sys
import tempfile


def main():
    folder = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "buchhwin-dwl"
    config = folder / "fastfetch.jsonc"
    data = json.loads(config.read_text())
    if sys.argv[1:] == ["get"]:
        source = data.get("logo", {}).get("source", "")
        path = Path(source).expanduser() if source else None
    elif len(sys.argv) == 3 and sys.argv[1] == "set":
        path = Path(sys.argv[2]).expanduser().resolve(strict=True)
        if not path.is_file():
            raise ValueError("Please select an image file")
        with path.open("rb") as image:
            header = image.read(12)
        if not (header.startswith(b"\x89PNG\r\n\x1a\n") or header.startswith(b"\xff\xd8\xff")
                or header.startswith(b"BM") or (header[:4] == b"RIFF" and header[8:12] == b"WEBP")):
            raise ValueError("Choose a PNG, JPEG, WebP or BMP image")
        data.setdefault("logo", {}).update(type="kitty-direct", source=str(path))
        fd, temporary = tempfile.mkstemp(dir=folder, prefix=".fastfetch-")
        try:
            with os.fdopen(fd, "w") as output:
                json.dump(data, output, indent=2, ensure_ascii=False)
                output.write("\n")
            os.replace(temporary, config)
        finally:
            Path(temporary).unlink(missing_ok=True)
    else:
        raise ValueError("Usage: buchhwin-fastfetch-image get|set IMAGE")
    print(json.dumps({"path": str(path) if path else "", "url": path.as_uri() if path and path.is_absolute() else ""}))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, TypeError, AttributeError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
